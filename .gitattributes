# Force LF for shell scripts and config files to avoid CRLF issues in Docker/Linux
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.env         text eol=lf
*.py          text eol=lf

# Allow CRLF for Windows-specific files
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf
