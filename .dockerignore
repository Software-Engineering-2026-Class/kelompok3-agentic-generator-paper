# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─── Virtual environments ───────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Secrets / env files (NEVER bake into image) ───────────────────
.env
.env.*
!.env.example

# ─── Output / generated artifacts ─────────────────────────────────
output_files/**/*.py
output_files/**/__pycache__/
*.log
logs/

# ─── IDE / editor configs ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Git ───────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── Docker (self-referential, avoid recursion) ────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ─── Documentation that is not needed at runtime ───────────────────
docs/
paper/
LICENSE
README.md
ARCHITECTURE_MAP.md
REPOSITORY_GUIDE.md
help.md

# ─── Pre-generated output (regenerated at runtime) ────────────────
generated_kg/
agent-o/
