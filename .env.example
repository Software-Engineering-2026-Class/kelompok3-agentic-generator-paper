# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real secrets.
#
# Only the `prompt` service (LLM ontology-population) actually requires
# OPENAI_API_KEY. The default `app` pipeline (normalize -> generate ->
# validate -> stats) does NOT call the OpenAI API and will run without it.

OPENAI_API_KEY=sk-your-real-key-here
